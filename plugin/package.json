{
  "name": "dsh-doctor-plugin",
  "version": "0.13.10",
  "description": "DSH 私人医生：检查并一键修复桌面端在 Windows 上踩过的坑（桌面图标变白/闪烁、工作区注册在桌面、profile 宿主包重复、启动崩溃）",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jincheng3870682453-hash/dsh-doctor.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/jincheng3870682453-hash/dsh-doctor#readme",
  "bugs": "https://github.com/jincheng3870682453-hash/dsh-doctor/issues",
  "keywords": ["dsh", "deepseek", "deepseek-harness", "diagnostics", "repair", "windows", "plugin"],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["lib/", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
